{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuardRail procurement report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "currency",
    "lines"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "const": "HKD"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_id",
          "sku",
          "qty",
          "unit_minor",
          "declared_minor",
          "delta_minor"
        ],
        "properties": {
          "line_id": {
            "type": "string",
            "minLength": 1
          },
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "unit_minor": {
            "type": "integer",
            "minimum": 0
          },
          "declared_minor": {
            "type": "integer",
            "minimum": 0
          },
          "delta_minor": {
            "type": "integer"
          }
        }
      }
    }
  }
}
